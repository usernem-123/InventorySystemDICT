@model InventorySystem.Models.ViewModels.CardViewModel

<a asp-controller="@Model.Controller"
   asp-action="@Model.Action"
   class="text-decoration-none text-dark">

    <div class="card dashboard-card shadow-sm border-0 h-100">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted">
                        @Model.Title
                    </small>

                    <h2 class="fw-bold mt-2 mb-0">
                        @Model.Count
                    </h2>

                </div>

                <i class="@Model.Icon text-@Model.Color fa-3x"></i>

            </div>

        </div>

    </div>

</a>