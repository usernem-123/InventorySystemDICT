<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>@ViewData["Title"] - Inventory Owl</title>

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />


<style>


*{

    box-sizing:border-box;

}


body{

    background:#F6F1EB;

    overflow-x:hidden;

    font-family:"Segoe UI",sans-serif;

}





/* SIDEBAR */


.sidebar{


    position:fixed;

    left:0;

    top:0;

    width:260px;

    height:100vh;


    background:

    linear-gradient(
        180deg,
        #4D311C,
        #2d1c10
    );


    color:white;


    box-shadow:

    10px 0 40px rgba(0,0,0,.15);


}





.sidebar-header{

    height:90px;

    display:flex;

    align-items:center;

    padding:20px 25px;

    font-size:26px;

    font-weight:700;

    color:#F6E7D5;

    border-bottom:1px solid rgba(255,255,255,.15);

}



.sidebar-logo{

    width:45px;

    height:45px;

    object-fit:contain;

    margin-right:12px;

}







.sidebar a{


    display:flex;


    align-items:center;


    gap:12px;


    padding:15px 25px;


    color:#ddd;


    text-decoration:none;


    transition:.25s;


    font-size:16px;


}





.sidebar a:hover{


    background:#B56A2E;


    color:white;


    padding-left:35px;


}




.sidebar i{


    width:25px;

    font-size:18px;


}








/* CONTENT */


.content{


    margin-left:260px;


    padding:30px;


}






/* TOPBAR */


.topbar{


    background:white;


    border-radius:25px;


    padding:20px 30px;


    margin-bottom:30px;


    display:flex;


    justify-content:space-between;


    align-items:center;


    box-shadow:

    0 15px 40px rgba(0,0,0,.08);


}





.topbar h4{


    color:#4D311C;


    font-weight:700;


}





.topbar strong{


    color:#B56A2E;


}






/* ACTIVE EFFECT */


.sidebar a.active{


    background:#B56A2E;


    color:white;


}





</style>


</head>



<body>


<div class="sidebar">


    <div class="sidebar-header">

        <img src="~/images/owl.webp"
            asp-append-version="true"
            class="sidebar-logo" />

        <span>
            Inventory Owl
        </span>

    </div>




    <a asp-controller="Dashboard" asp-action="Index">

        <i class="fa-solid fa-chart-line"></i>

        Dashboard

    </a>




@if(User.IsInRole("Admin"))
{

    <a asp-controller="Users" asp-action="Index">

        <i class="fa-solid fa-users"></i>

        Users

    </a>

}




    <a asp-controller="Inventory" asp-action="Index">

        <i class="fa-solid fa-box"></i>

        Inventory

    </a>




    <a asp-controller="Transactions" asp-action="Index">

        <i class="fa-solid fa-hand-holding"></i>

        Transactions

    </a>




    <a asp-controller="Borrowers" asp-action="Index">

        <i class="fa-solid fa-user"></i>

        Borrowers

    </a>




    <a asp-controller="Transactions" asp-action="Return">

        <i class="fa-solid fa-arrow-rotate-left"></i>

        Return

    </a>




    <a asp-controller="Transactions" asp-action="Receive">

        <i class="fa-solid fa-truck-ramp-box"></i>

        Receive

    </a>




    <a asp-controller="Defects" asp-action="Index">

        <i class="fa-solid fa-triangle-exclamation"></i>

        Defects

    </a>




    <a asp-controller="Categories" asp-action="Index">

        <i class="fa-solid fa-layer-group"></i>

        Categories

    </a>




    <a asp-controller="Reports" asp-action="Index">

        <i class="fa-solid fa-chart-column"></i>

        Reports

    </a>




    <a asp-controller="Account" asp-action="Logout">

        <i class="fa-solid fa-right-from-bracket"></i>

        Logout

    </a>


</div>





<div class="content">



    <div class="topbar">


        <h4 class="mb-0">

            @ViewData["Title"]

        </h4>



        <div>

            Welcome,

            <strong>
                @User.Identity?.Name
            </strong>

        </div>



    </div>




    @RenderBody()



</div>





<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


@await RenderSectionAsync("Scripts", required:false)


</body>
</html>