@model InventorySystem.Models.Borrower

@{
    ViewData["Title"] = "Add Borrower";
}

<div class="card shadow">

    <div class="card-header bg-success text-white">
        <h4>Add Borrower</h4>
    </div>

    <div class="card-body">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Type" class="form-label"></label>

                <select asp-for="Type"
                        class="form-select"
                        id="BorrowerType">

                    <option value="Individual">Individual</option>
                    <option value="Institution">Institution / Agency</option>

                </select>
            </div>

            <div class="mb-3">
                <label asp-for="FullName"
                       id="nameLabel"
                       class="form-label">
                </label>

                <input asp-for="FullName"
                       class="form-control" />

                <span asp-validation-for="FullName"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Department"
                       class="form-label">
                </label>

                <input asp-for="Department"
                       class="form-control" />
            </div>

            <div class="mb-3"
                 id="positionSection">

                <label asp-for="Position"
                       class="form-label">
                </label>

                <input asp-for="Position"
                       class="form-control" />

            </div>

            <div class="mb-3">
                <label asp-for="ContactNumber"
                       class="form-label">
                </label>

                <input asp-for="ContactNumber"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Email"
                       class="form-label">
                </label>

                <input asp-for="Email"
                       class="form-control" />
            </div>

            <button class="btn btn-success">
                Save
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial"/>

    <script>

        function updateBorrowerForm() {

            const type = document.getElementById("BorrowerType").value;

            const label = document.getElementById("nameLabel");
            const position = document.getElementById("positionSection");

            if (type === "Institution") {

                label.textContent = "Institution / Agency";
                position.classList.add("d-none");

            }
            else {

                label.textContent = "Full Name";
                position.classList.remove("d-none");

            }
        }

        document
            .getElementById("BorrowerType")
            .addEventListener("change", updateBorrowerForm);

        updateBorrowerForm();

    </script>
}