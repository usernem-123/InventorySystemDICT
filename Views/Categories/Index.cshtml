@model IEnumerable<InventorySystem.Models.ViewModels.CategoryIndexViewModel>

@{
    ViewData["Title"] = "Categories";

    var ictCategories = Model.Where(c => c.Name == "ICT").ToList();
    var nonIctCategories = Model.Where(c => c.Name != "ICT").ToList();
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold">
            Categories
        </h2>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow border-0">

        <div class="table-responsive">

            <!-- ICT Categories -->
<div class="card shadow border-0 mb-4">

    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">ICT Categories</h5>
    </div>

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th>Category</th>
                    <th class="text-center">Available</th>
                    <th class="text-center">Borrowed</th>
                    <th class="text-center">Total Assets</th>
                    <th class="text-center">Minimum</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>

            <tbody>

            @if(!ictCategories.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        No ICT categories found.
                    </td>
                </tr>
            }

            @foreach(var category in ictCategories)
            {
                <tr>

                    <td>
                        <strong>@category.Name</strong>
                    </td>

                    <td class="text-center">
                        <span class="badge bg-success">
                            @category.AvailableAssets
                        </span>
                    </td>

                    <td class="text-center">
                        <span class="badge bg-warning text-dark">
                            @category.BorrowedAssets
                        </span>
                    </td>

                    <td class="text-center">
                        <span class="badge bg-primary">
                            @category.TotalAssets
                        </span>
                    </td>

                    <td class="text-center">
                        @category.MinimumStock
                    </td>

                    <td class="text-center">

                        @if(category.IsLowStock)
                        {
                            <span class="badge bg-danger">
                                Low Stock
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Normal
                            </span>
                        }

                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>

</div>


<!-- Non ICT Categories -->
<div class="card shadow border-0">

    <div class="card-header bg-success text-white">
        <h5 class="mb-0">Non-ICT Supplies</h5>
    </div>

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">

                <tr>
                    <th>Category</th>
                    <th class="text-center">Quantity</th>
                    <th class="text-center">Total Assets</th>
                    <th class="text-center">Status</th>
                </tr>

            </thead>

            <tbody>

            @if(!nonIctCategories.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No Non-ICT categories found.
                    </td>
                </tr>
            }

            @foreach(var category in nonIctCategories)
            {
                <tr>

                    <td>
                        <strong>@category.Name</strong>
                    </td>

                    <td class="text-center">
                        @category.TotalAssets
                    </td>

                    <td class="text-center">

                        <span class="badge bg-primary">
                            @category.TotalAssets
                        </span>

                    </td>

                    <td class="text-center">

                        @if(category.IsLowStock)
                        {
                            <span class="badge bg-danger">
                                Low Stock
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Normal
                            </span>
                        }

                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>

</div>

        </div>

    </div>

</div>