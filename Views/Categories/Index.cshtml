@model IEnumerable<InventorySystem.Models.ViewModels.CategoryIndexViewModel>

@{
    ViewData["Title"] = "Categories";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold">
            Categories
        </h2>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid fa-plus"></i>
            Add Category

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow border-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Category</th>
                        <th>Description</th>
                        <th class="text-center">Available</th>
                        <th class="text-center">Borrowed</th>
                        <th class="text-center">Total Assets</th>
                        <th class="text-center">Minimum</th>
                        <th class="text-center">Status</th>
                        <th width="140"></th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="8" class="text-center text-muted py-4">

                                No categories found.

                            </td>

                        </tr>
                    }

                    @foreach (var category in Model)
                    {
                        <tr>

                            <td>

                                <strong>@category.Name</strong>

                            </td>

                            <td>

                                @(string.IsNullOrWhiteSpace(category.Description)
                                    ? "-"
                                    : category.Description)

                            </td>

                            <td class="text-center">

                                <span class="badge bg-success">

                                    @category.AvailableAssets

                                </span>

                            </td>

                            <td class="text-center">

                                <span class="badge bg-warning text-dark">

                                    @category.BorrowedAssets

                                </span>

                            </td>

                            <td class="text-center">

                                <span class="badge bg-primary">

                                    @category.TotalAssets

                                </span>

                            </td>

                            <td class="text-center">

                                @category.MinimumStock

                            </td>

                            <td class="text-center">

                                @if (category.IsLowStock)
                                {
                                    <span class="badge bg-danger">

                                        Low Stock

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">

                                        Normal

                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@category.Id"
                                   class="btn btn-sm btn-warning">

                                    <i class="fa-solid fa-pen"></i>

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@category.Id"
                                   class="btn btn-sm btn-danger">

                                    <i class="fa-solid fa-trash"></i>

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>