@model InventorySystem.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>eShelf</title>

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Segoe UI",sans-serif;
}

body{

    height:100vh;

    background:#EEF6FF;

    overflow:hidden;

}

.wrapper{

    display:flex;

    height:100vh;

}

/* LEFT */

.left{
    width:50%;
    position:relative;
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
    overflow:hidden;
    background:#EEF6FF;

}

.left::after{
    content:"";
    position:absolute;
    top:0;
    right:-140px;

    width:300px;
    height:100%;

    background:#fff;
    border-radius:30%;
    z-index:1;
}

.left::before{
    content:"";
    position:absolute;
    inset:0;


    background-size:150% auto;

    opacity:.12;

    z-index:0;
}

/* TITLE */

.brand{

    position:relative;

    z-index:2;

    text-align:center;

}

.brand h5{
    color:#3B82F6;
    font-size:30px;
    font-family:cursive;
}

.brand h1{
    font-size:64px;
    font-weight:700;
    color:#1E3A8A;
}

.brand p{
    color:#64748B;
    margin-top:10px;
}

/* OWL */

.owl{

    position:relative;

    z-index:2;

    width:280px;

    margin-top:25px;

    animation:float 3s infinite ease-in-out;

}

@@keyframes float{

50%{

transform:translateY(-15px);

}

}

/* CHAT */

.chat{
    z-index:2;
    background:white;
    margin-top:25px;
    padding:18px;
    border-radius:18px;
    box-shadow:0 15px 40px rgba(59,130,246,.12);
    text-align:center;
}


/* RIGHT */

.right{

    width:50%;

    display:flex;

    justify-content:center;

    align-items:center;

    background:white;

}

/* LOGIN CARD */

.card-login{
    width:500px;
    background:white;
    border-radius:30px;
    padding:50px;
    box-shadow:0 20px 60px rgba(59,130,246,.15);
}

.lock{
    width:85px;
    height:85px;
    margin:auto;
    border-radius:50%;
    background:#DCEEFF;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:12px;
}

.lock img{

    width:100%;
    height:100%;

    object-fit:contain;

}

.card-login h2{
    margin-top:20px;
    text-align:center;
    font-size:42px;
    font-weight:700;
    color:#1E3A8A;
}

.subtitle{
    text-align:center;
    color:#64748B;
    margin-bottom:35px;
}

.form-control{
    height:55px;
    border-radius:12px;
    border:1px solid #BFDBFE;
}

.form-control:focus{
    border-color:#3B82F6;
    box-shadow:0 0 0 .25rem rgba(59,130,246,.18);
}

.btn-login{
    height:55px;
    border-radius:12px;
    background:#3B82F6;
    border:none;
    color:white;
    font-weight:600;
    transition:.2s;
}

.btn-login:hover{
    background:#2563EB;
}

.footer{
    margin-top:25px;
    text-align:center;
    color:#64748B;
    font-size:14px;
}

.dict-logo{

    width:120px;
    height:120px;

    margin:0 auto 25px;

    display:flex;
    justify-content:center;
    align-items:center;

}

.dict-logo img{

    width:100%;
    height:100%;

    object-fit:contain;

}

</style>

</head>

<body>

<div class="wrapper">

<div class="left">



<div class="brand">

<h5>Welcome to</h5>

<h1>eShelf</h1>

<p>Smart Inventory. Clear Insights. Better Management.</p>

</div>

<img src="~/images/tbl.png"
class="owl"
asp-append-version="true"/>

<div class="chat">

<strong>Hello there!</strong>

<br>

Let's keep your inventory organized and under control.

</div>

</div>

<div class="right">

<div class="card-login">

<div class="card-login">

<div class="dict-logo">

    <img src="~/images/dictlogo.png"
         asp-append-version="true"
         alt="DICT Logo">

</div>

<h2>Login</h2>

<div class="subtitle">

Please sign in to continue

</div>

<form asp-action="Login" method="post">

<div class="mb-3">

<label class="mb-2">Username</label>

<input asp-for="Username" class="form-control">

</div>

<div class="mb-4">

<label class="mb-2">Password</label>

<input asp-for="Password"
type="password"
class="form-control">

</div>

<div asp-validation-summary="All"
class="text-danger mb-3">
</div>

<button class="btn btn-login w-100">

<i class="fa-solid fa-right-to-bracket"></i>

&nbsp;

Login

</button>

</form>

<div class="footer">

© @DateTime.UtcNow.Year eShelf. All rights reserved.

</div>

</div>

</div>

</div>

</body>
</html>