@model List<InventorySystem.Models.Transaction>

@{
    ViewData["Title"] = "Transactions";
}


<div class="card shadow">

    <div class="card-header bg-primary text-white d-flex justify-content-between">

        <h4 class="mb-0">
            Transaction History
        </h4>


        <a asp-action="Borrow"
           class="btn btn-light">

            Borrow Item

        </a>

    </div>


    <div class="card-body">


        <table class="table table-hover align-middle">

    <thead class="table-light">
        <tr>
            <th>Date</th>
            <th>Transaction</th>
            <th>Item</th>
            <th>Details</th>
            <th>Borrower</th>
            <th>Remarks/Purpose</th>
        </tr>
    </thead>

    <tbody>

    @foreach (var t in Model)
    {
        <tr>

            <td>
                @t.TransactionDate.ToString("MMM dd, yyyy HH:mm")
            </td>

            <td>

                @switch (t.TransactionType)
                {
                    case TransactionType.Borrow:
                        <span class="badge bg-warning text-dark">Borrow</span>
                        break;

                    case TransactionType.Return:
                        <span class="badge bg-success">Return</span>
                        break;

                    case TransactionType.Receive:
                        <span class="badge bg-info">Receive</span>
                        break;
                }

            </td>

            <td>
                <strong>@t.Item?.ItemName</strong>
            </td>

            <td>

                @if (t.Item?.Category?.Type == CategoryType.ICT)
                {
                    <span>
                        SN:
                        <strong>@t.Item.SerialNumber</strong>
                    </span>
                }
                else
                {
                    <span>
                        Qty:
                        <strong>@t.Quantity</strong>
                    </span>
                }

            </td>

            <td>

                @if (t.TransactionType == TransactionType.Receive)
                {
                    <span class="text-muted">—</span>
                }
                else
                {
                    @t.Borrower?.FullName
                }

            </td>

            <td>@t.Remarks</td>

        </tr>
    }

    </tbody>

</table>


    </div>


</div>