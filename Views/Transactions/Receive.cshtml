@model InventorySystem.Models.ViewModels.ReceiveViewModel

@{
    ViewData["Title"] = "Receive Item";
}

<div class="container-fluid py-4">

    <div class="card shadow border-0">

        <div class="card-header bg-info text-white">
            <h4 class="mb-0">
                Receive Inventory Item
            </h4>
        </div>


        <div class="card-body">

            <form asp-action="Receive" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Existing Item
                    </label>

                    <select asp-for="ExistingItemId"
                            id="ExistingItemId"
                            asp-items="Model.ExistingItems"
                            class="form-select">

                        <option value="">
                            New Item
                        </option>

                    </select>

                    <small class="text-muted">
                        Select existing item to copy details, then enter new serial number.
                    </small>

                </div>


                <hr />


                <div class="mb-3">

                    <label asp-for="ItemName"
                           class="form-label">
                    </label>

                    <input asp-for="ItemName"
                           id="ItemName"
                           class="form-control" />

                    <span asp-validation-for="ItemName"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              id="Description"
                              class="form-control"></textarea>

                </div>


                <div class="mb-3">

                    <label asp-for="CategoryId"
                           class="form-label">
                    </label>

                    <select asp-for="CategoryId"
                            id="CategoryId"
                            class="form-select">

                        <option value="">Select Category</option>

                        @foreach(var category in Model.CategoryList)
                        {
                            <option value="@category.Id"
                                    data-type="@category.Type">
                                @category.Name
                            </option>
                        }
                    </select>

                </div>


                <div class="row">

                    <div class="col-md-6">

                        <label asp-for="Location"
                               class="form-label">
                        </label>

                        <input asp-for="Location"
                               id="Location"
                               class="form-control" />

                    </div>


                    <div class="col-md-6" id="serialSection">

                        <label asp-for="SerialNumber"
                               class="form-label">
                        </label>

                        <input asp-for="SerialNumber"
                            id="SerialNumber"
                            class="form-control" />

                        <span asp-validation-for="SerialNumber"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="row mt-3" id="quantitySection" style="display:none;">

                    <div class="col-md-6" id="quantitySection">

                        <label asp-for="Quantity" class="form-label"></label>

                        <input asp-for="Quantity"
                            class="form-control"
                            type="number"
                            min="1"
                            id="Quantity"/>

                    </div>

                </div>


                <div class="mb-3 mt-3">

                    <label asp-for="Remarks"
                           class="form-label">
                    </label>

                    <textarea asp-for="Remarks"
                              class="form-control"></textarea>

                </div>


                <button class="btn btn-info text-white">
                    Receive Item
                </button>


                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>


            </form>

        </div>

    </div>

</div>


@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
<script>

document.addEventListener("DOMContentLoaded", () => {

    const existingItem = document.getElementById("ExistingItemId");
    const existingItemSelect = new TomSelect("#ExistingItemId", {
        create: false,
        allowEmptyOption: true,
        placeholder: "Search by code, item name or serial...",
        maxOptions: 1000,
        searchField: ["text"],
        openOnFocus: true,
        highlight: true
    });
    const category = document.getElementById("CategoryId");
    const itemName = document.getElementById("ItemName");
    const description = document.getElementById("Description");
    const location = document.getElementById("Location");
    const serialNumber = document.getElementById("SerialNumber");
    const quantity = document.getElementById("Quantity");

    function updateForm() {

        const serialSection = document.getElementById("serialSection");
        const quantitySection = document.getElementById("quantitySection");
        if (category.selectedIndex <= 0) {

            serialSection.style.display = "block";
            quantitySection.style.display = "block";

            serialNumber.disabled = false;
            quantity.disabled = false;

            quantity.value = 1;

            return;
        }

        const option = category.options[category.selectedIndex];
        const type = option.dataset.type;

        if (type === "NonICT") {

            serialSection.style.display = "none";
            quantitySection.style.display = "block";

            serialNumber.value = "";
            serialNumber.disabled = true;

            quantity.disabled = false;

        }
        else {

            serialSection.style.display = "block";
            quantitySection.style.display = "none";

            serialNumber.disabled = false;

            quantity.value = 1;
            quantity.disabled = true;
        }
    }

    category.addEventListener("change", () => {

        if (existingItem.value !== "") {

            const selectedOption = category.options[category.selectedIndex];

            if (selectedOption.dataset.type === "NonICT") {

                existingItemSelect.clear();

                itemName.value = "";
                description.value = "";
                location.value = "";
                serialNumber.value = "";
            }
        }

        updateForm();

    });

    existingItem.addEventListener("change", async function () {

        if (this.value === "") {

            itemName.value = "";
            description.value = "";
            category.selectedIndex = 0;
            location.value = "";
            serialNumber.value = "";

            updateForm();

            return;
        }

        const response = await fetch(`/Transactions/GetItem/${this.value}`);

        if (!response.ok) {

            console.log("Failed to load item");
            return;

        }

        const item = await response.json();

        itemName.value = item.itemName ?? "";
        description.value = item.description ?? "";
        category.value = item.categoryId;
        location.value = item.location ?? "";

        updateForm();

    });

    updateForm();

});

</script>

<partial name="_ValidationScriptsPartial" />

}