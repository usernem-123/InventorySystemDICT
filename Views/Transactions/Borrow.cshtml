@using InventorySystem.Models

@{
    ViewData["Title"] = "Borrow Items";
}

<div class="card shadow">

    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">
            <i class="fa-solid fa-hand-holding"></i>
            Borrow ICT Items
        </h4>
    </div>

    <div class="card-body">

        <form asp-action="Borrow" method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Available ICT Assets
                </label>

                <input type="text"
                       id="searchItems"
                       class="form-control mb-3"
                       placeholder="Search by item name, code, or serial number..." />

                <small class="text-muted">
                    Click an item to select it for borrowing. Click again to deselect.
                </small>

            </div>

            <div id="availableItems"
                 class="row g-3"
                 style="max-height:450px; overflow-y:auto;">

                @foreach (var item in ViewBag.Items)
{
    if (item.Category != null &&
        item.Category.Name.Equals("ICT", StringComparison.OrdinalIgnoreCase))
    {
        <div class="col-md-4 item-container">

            <div class="card item-card h-100 shadow-sm"
                 data-id="@item.Id"
                 data-search="@($"{item.ItemName} {item.ItemCode} {item.SerialNumber}".ToLower())"
                 style="cursor:pointer; transition:.2s;">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h6 class="fw-bold mb-1">
                                @item.ItemName
                            </h6>

                            <div class="text-muted small">
                                <strong>Code:</strong> @item.ItemCode
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.SerialNumber))
                            {
                                <div class="text-muted small">
                                    <strong>Serial:</strong> @item.SerialNumber
                                </div>
                            }

                            <div class="text-muted small">
                                <strong>Location:</strong> @item.Location
                            </div>

                        </div>

                        <i class="fa-solid fa-circle-check fa-xl text-success check-icon d-none"></i>

                    </div>

                </div>

            </div>

        </div>
    }
}

            </div>

            <div class="mt-3">

                <span class="badge bg-success fs-6">
                    Selected Items:
                    <span id="selectedCount">0</span>
                </span>

            </div>

            <hr />

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Borrower
                </label>

                <select name="borrowerId"
                        class="form-select"
                        required>

                    <option value="">
                        Select Borrower
                    </option>

                    @foreach (var borrower in ViewBag.Borrowers)
                    {
                        <option value="@borrower.Id">
                            @borrower.FullName - @borrower.Department
                        </option>
                    }

                </select>

            </div>

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Remarks
                </label>

                <textarea name="remarks"
                          class="form-control"
                          rows="3"></textarea>

            </div>

            <div id="hiddenItems"></div>

            <button type="submit"
                    class="btn btn-success">

                <i class="fa-solid fa-check"></i>
                Borrow Selected Items

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancel

            </a>

        </form>

    </div>

</div>

@section Scripts
{
<script>

const selectedItems = new Set();

const hiddenContainer = document.getElementById("hiddenItems");
const selectedCount = document.getElementById("selectedCount");

function updateCount() {
    selectedCount.textContent = selectedItems.size;
}

document.querySelectorAll(".item-card").forEach(card => {

    card.addEventListener("click", function () {

        const id = this.dataset.id;
        const icon = this.querySelector(".check-icon");

        if (selectedItems.has(id)) {

            selectedItems.delete(id);

            this.classList.remove("border-success");
            this.classList.remove("bg-success-subtle");

            icon.classList.add("d-none");

        } else {

            selectedItems.add(id);

            this.classList.add("border-success");
            this.classList.add("bg-success-subtle");

            icon.classList.remove("d-none");

        }

        updateCount();

    });

});

document.getElementById("searchItems").addEventListener("keyup", function () {

    const value = this.value.toLowerCase();

    document.querySelectorAll(".item-card").forEach(card => {

        const match = card.dataset.search.includes(value);

        card.closest(".item-container").style.display = match ? "" : "none";

    });

});

document.querySelector("form").addEventListener("submit", function () {

    hiddenContainer.innerHTML = "";

    selectedItems.forEach(id => {

        const input = document.createElement("input");

        input.type = "hidden";
        input.name = "itemIds";
        input.value = id;

        hiddenContainer.appendChild(input);

    });

});

</script>
}