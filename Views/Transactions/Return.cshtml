@{
    ViewData["Title"] = "Return Items";
}

<div class="card shadow">

    <div class="card-header bg-success text-white">
        <h4 class="mb-0">
            Return Items
        </h4>
    </div>

    <div class="card-body">

        <form asp-action="Return" method="post">

            @Html.AntiForgeryToken()

            <div class="mb-4">

                <label class="form-label fw-bold">
                    Borrower
                </label>

                <select id="borrowerId"
                        name="borrowerId"
                        class="form-select"
                        required>

                    <option value="">
                        Select Borrower
                    </option>

                    @foreach (var borrower in ViewBag.Borrowers)
                    {
                        <option value="@borrower.Id">
                            @borrower.FullName
                        </option>
                    }

                </select>

            </div>

            <div class="row">

                <div class="col-md-5">

                    <label class="form-label fw-bold">
                        Borrowed Items
                    </label>

                    <select id="availableItems"
                            class="form-select"
                            size="12"
                            multiple
                            disabled>

                        <option>
                            Select a borrower first
                        </option>

                    </select>

                </div>

                <div class="col-md-2 d-flex flex-column justify-content-center">

                    <button type="button"
                            id="btnAdd"
                            class="btn btn-success mb-2">

                        <i class="fa-solid fa-arrow-right"></i>

                    </button>

                    <button type="button"
                            id="btnRemove"
                            class="btn btn-danger">

                        <i class="fa-solid fa-arrow-left"></i>

                    </button>

                </div>

                <div class="col-md-5">

                    <label class="form-label fw-bold">
                        Return List
                    </label>

                    <select id="returnItems"
                            class="form-select"
                            size="12"
                            multiple>
                    </select>

                </div>

            </div>

            <hr class="my-4"/>

            <div class="mb-3">

                <label class="form-label">
                    Remarks
                </label>

                <textarea name="remarks"
                          class="form-control"
                          rows="3"></textarea>

            </div>

            <div id="hiddenItems"></div>

            <button type="submit"
                    class="btn btn-success">

                <i class="fa-solid fa-arrow-rotate-left"></i>
                Return Selected Items

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancel

            </a>

        </form>

    </div>

</div>

@section Scripts{

<script>

const borrower = document.getElementById("borrowerId");
const available = document.getElementById("availableItems");
const selected = document.getElementById("returnItems");

borrower.addEventListener("change", async function () {

    available.innerHTML = "";
    selected.innerHTML = "";
    available.disabled = true;

    if (this.value === "") {

        available.innerHTML =
            "<option>Select a borrower first</option>";

        return;
    }

    const response = await fetch(
        `/Transactions/GetBorrowedItemsByBorrower?borrowerId=${this.value}`
    );

    if (!response.ok)
        return;

    const items = await response.json();

    available.innerHTML = "";

    if (items.length === 0) {

        available.innerHTML =
            "<option>No borrowed items</option>";

        return;
    }

    items.forEach(item => {

        const option = document.createElement("option");

        option.value = item.id;
        option.text = item.text;

        available.appendChild(option);

    });

    available.disabled = false;

});

document.getElementById("btnAdd").onclick = function () {

    [...available.selectedOptions].forEach(option => {

        selected.appendChild(option);

    });

};

document.getElementById("btnRemove").onclick = function () {

    [...selected.selectedOptions].forEach(option => {

        available.appendChild(option);

    });

};

document.querySelector("form").addEventListener("submit", function () {

    const hidden = document.getElementById("hiddenItems");

    hidden.innerHTML = "";

    [...selected.options].forEach(option => {

        const input = document.createElement("input");

        input.type = "hidden";
        input.name = "itemIds";
        input.value = option.value;

        hidden.appendChild(input);

    });

});

</script>

<partial name="_ValidationScriptsPartial"/>

}