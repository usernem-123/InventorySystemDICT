@{
    ViewData["Title"] = "Return Items";
}

<div class="card shadow">

    <div class="card-header bg-success text-white">
        <h4 class="mb-0">
            <i class="fa-solid fa-arrow-rotate-left"></i>
            Return ICT Items
        </h4>
    </div>

    <div class="card-body">

        <form asp-action="Return" method="post">

            @Html.AntiForgeryToken()

            <div class="mb-4">

                <label class="form-label fw-bold">
                    Borrower
                </label>

                <select id="borrowerId"
                        name="borrowerId"
                        class="form-select"
                        required>

                    <option value="">
                        Select Borrower
                    </option>

                    @foreach (var borrower in ViewBag.Borrowers)
                    {
                        <option value="@borrower.Id">
                            @borrower.FullName - @borrower.Department
                        </option>
                    }

                </select>

            </div>

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Borrowed ICT Assets
                </label>

                <input type="text"
                       id="searchItems"
                       class="form-control mb-3"
                       placeholder="Search item..." />

                <small class="text-muted">
                    Select a borrower, then click items to mark them for return.
                </small>

            </div>

            <div id="itemsContainer"
                 class="row g-3"
                 style="max-height:450px; overflow-y:auto;">

                <div class="col-12 text-center text-muted py-5">
                    Select a borrower first.
                </div>

            </div>

            <div class="mt-3">

                <span class="badge bg-success fs-6">
                    Selected:
                    <span id="selectedCount">0</span>
                </span>

            </div>

            <hr />

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Remarks
                </label>

                <textarea name="remarks"
                          class="form-control"
                          rows="3"></textarea>

            </div>

            <div id="hiddenItems"></div>

            <button class="btn btn-success">
                <i class="fa-solid fa-arrow-rotate-left"></i>
                Return Selected Items
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>

@section Scripts{

<script>

const borrower=document.getElementById("borrowerId");
const container=document.getElementById("itemsContainer");
const search=document.getElementById("searchItems");
const hidden=document.getElementById("hiddenItems");
const count=document.getElementById("selectedCount");

const selected=new Set();

function updateCount(){
    count.textContent=selected.size;
}

borrower.addEventListener("change",async()=>{

    container.innerHTML="";
    selected.clear();
    updateCount();

    if(!borrower.value){

        container.innerHTML=`
            <div class="col-12 text-center text-muted py-5">
                Select a borrower first.
            </div>`;

        return;
    }

    const res=await fetch(`/Transactions/GetBorrowedItemsByBorrower?borrowerId=${borrower.value}`);

    const items=await res.json();

    if(items.length===0){

        container.innerHTML=`
            <div class="col-12 text-center text-muted py-5">
                No borrowed ICT items found.
            </div>`;

        return;
    }

    items.forEach(item=>{

        container.insertAdjacentHTML("beforeend",`

        <div class="col-md-4 item-container">

            <div class="card item-card shadow-sm h-100"
                 data-id="${item.id}"
                 data-search="${item.text.toLowerCase()}"
                 style="cursor:pointer;transition:.2s;">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h6 class="fw-bold mb-1">
                                ${item.text}
                            </h6>

                        </div>

                        <i class="fa-solid fa-circle-check fa-xl text-success check-icon d-none"></i>

                    </div>

                </div>

            </div>

        </div>

        `);

    });

    attachEvents();

});

function attachEvents(){

    document.querySelectorAll(".item-card").forEach(card=>{

        card.onclick=function(){

            const id=this.dataset.id;

            const icon=this.querySelector(".check-icon");

            if(selected.has(id)){

                selected.delete(id);

                this.classList.remove("border-success");
                this.classList.remove("bg-success-subtle");

                icon.classList.add("d-none");

            }else{

                selected.add(id);

                this.classList.add("border-success");
                this.classList.add("bg-success-subtle");

                icon.classList.remove("d-none");

            }

            updateCount();

        };

    });

}

search.addEventListener("keyup",()=>{

    const value=search.value.toLowerCase();

    document.querySelectorAll(".item-card").forEach(card=>{

        card.closest(".item-container").style.display=
            card.dataset.search.includes(value)
            ? ""
            : "none";

    });

});

document.querySelector("form").addEventListener("submit",()=>{

    hidden.innerHTML="";

    selected.forEach(id=>{

        hidden.insertAdjacentHTML(
            "beforeend",
            `<input type="hidden" name="itemIds" value="${id}">`
        );

    });

});

</script>

<partial name="_ValidationScriptsPartial"/>

}