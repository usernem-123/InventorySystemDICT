@model InventorySystem.Models.ViewModels.InventoryFormViewModel

@{
    ViewData["Title"] = "Add Item";
}

<div class="container-fluid py-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                Add Inventory Item
            </h4>
        </div>


        <div class="card-body">

            <div asp-validation-summary="ModelOnly"
                class="alert alert-danger">
            </div>

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Item Code
                    </label>

                    <input asp-for="ItemCode"
                           class="form-control"
                           readonly />

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Item Name
                    </label>

                    <input asp-for="ItemName" id="ItemName"
                           class="form-control"  disabled/>

                    <span asp-validation-for="ItemName"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Category
                    </label>

                    <select asp-for="CategoryId"
                            asp-items="Model.Categories"
                            class="form-select"
                            id="CategoryId">
                        <option value="">Select Category</option>
                    </select>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description" id="Description"
                              class="form-control" disabled>
                    </textarea>

                </div>
                <div id="serialGroup" class="mb-3">

                    <label asp-for="SerialNumber" class="form-label"></label>

                    <input asp-for="SerialNumber" id="SerialNumber"
                        class="form-control"
                        disabled />

                    <span asp-validation-for="SerialNumber"
                        class="text-danger"></span>

                </div>

                <div id="quantityGroup" class="mb-3" style="display:none;">

                    <label asp-for="Quantity" class="form-label"></label>

                    <input asp-for="Quantity" id="Quantity"
                        class="form-control"
                        disabled />

                    <span asp-validation-for="Quantity"
                        class="text-danger"></span>

                </div>


                <div class="row">

                    


                    <div class="col-md-6">

                        <label class="form-label">
                            Location
                        </label>

                        <input asp-for="Location" id="Location"
                               class="form-control" disabled/>

                    </div>

                </div>


                <div class="mt-4">

                    <button class="btn btn-success">
                        Save Item
                    </button>


                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                </div>


            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <script>
        

        const category = document.getElementById("CategoryId");

        const itemName = document.getElementById("ItemName");
        const description = document.getElementById("Description");
        const serial = document.getElementById("SerialNumber");
        const quantity = document.getElementById("Quantity");
        const locationInput = document.getElementById("Location");

        const serialGroup = document.getElementById("serialGroup");
        const quantityGroup = document.getElementById("quantityGroup");
        
        function toggleFields() {

            const selected = category.options[category.selectedIndex].text;
            const hasCategory = category.value !== "";

            itemName.disabled = !hasCategory;
            description.disabled = !hasCategory;
            locationInput.disabled = !hasCategory;

            if (!hasCategory) {
                serialGroup.style.display = "none";
                quantityGroup.style.display = "none";

                serial.disabled = true;
                quantity.disabled = true;
                return;
            }

            if (selected === "ICT") {

                serialGroup.style.display = "";
                quantityGroup.style.display = "none";

                serial.disabled = false;
                quantity.disabled = true;

            } else {

                serialGroup.style.display = "none";
                quantityGroup.style.display = "";

                serial.disabled = true;
                quantity.disabled = false;
            }
        }

        category.addEventListener("change", toggleFields);

        toggleFields();
    </script>
}