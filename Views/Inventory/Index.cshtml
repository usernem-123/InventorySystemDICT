@model InventorySystem.Models.ViewModels.InventoryIndexViewModel
@using InventorySystem.Models

@{
    ViewData["Title"] = "Inventory";

    var ictItems = Model.Items.Where(i => i.Category?.Name == "ICT").ToList();
    var nonIctItems = Model.Items.Where(i => i.Category?.Name != "ICT").ToList();
    var selectedCategory = Model.Categories
        .FirstOrDefault(c => c.Value == Model.CategoryId?.ToString())?.Text;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold">
            Inventory
        </h2>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid fa-plus"></i>
            Add Item

        </a>

    </div>


    <div class="card shadow border-0 mb-4">

        <div class="card-body">

            <form method="get">

                <div class="row">

                    <div class="col-md-5">

                        <input name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="Search item..." />

                    </div>

                    <div class="col-md-4">

                        <select name="categoryId"
                                class="form-select">

                            <option value="">
                                All Categories
                            </option>

                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Value"
                                        selected="@(c.Value == Model.CategoryId?.ToString())">
                                    @c.Text
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-3">

                        <button class="btn btn-dark w-100">

                            <i class="fa-solid fa-filter"></i>
                            Filter

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

@if(Model.CategoryId == null || selectedCategory == "ICT")
{
    <div class="card shadow border-0 mb-4">

    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">ICT Assets</h5>
    </div>

    <div class="table-responsive">

        <table class="table table-hover mb-0">

            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Item</th>
                    <th>Category</th>
                    <th>Times Borrowed</th>
                    <th>Serial Number</th>
                    <th>Status</th>
                    <th>Location</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>

            @if (ictItems.Any())
            {
                @foreach (var item in ictItems)
                {
                    <tr>
                        <td>@item.ItemCode</td>
                        <td>@item.ItemName</td>
                        <td>@item.Category?.Name</td>
                        <td>
                            @(item.Transactions?.Count(t => t.TransactionType == TransactionType.Borrow) ?? 0)
                        </td>
                        <td>@item.SerialNumber</td>
                        <td>
                            @if (item.Status == ItemStatus.Available)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else if (item.Status == ItemStatus.Borrowed)
                            {
                                <span class="badge bg-warning text-dark">Borrowed</span>
                            }
                            else if (item.Status == ItemStatus.Defective)
                            {
                                <span class="badge bg-danger">Defective</span>
                            }
                        </td>

                        <td>@item.Location</td>

                        <td class="text-center">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm">
                                <i class="fa fa-eye"></i>
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                <i class="fa fa-edit"></i>
                            </a>

                            @if (item.Status == ItemStatus.Available)
                            {
                                <form asp-controller="Defects"
                                      asp-action="MarkDefective"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="id" value="@item.Id" />

                                    <button class="btn btn-danger btn-sm">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                    </button>

                                </form>
                            }

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">No ICT assets found.</td>
                </tr>
            }

            </tbody>

        </table>

    </div>

</div>
}
    

@if(Model.CategoryId == null || selectedCategory != "ICT"){
<div class="card shadow border-0">

    <div class="card-header bg-success text-white">
        <h5 class="mb-0">Non-ICT Supplies</h5>
    </div>

    <div class="table-responsive">

        <table class="table table-hover mb-0">

            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Item</th>
                    <th>Category</th>
                    <th>Quantity</th>
                    <th>Location</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>

            @if (nonIctItems.Any())
            {
                @foreach (var item in nonIctItems)
                {
                    <tr>

                        <td>@item.ItemCode</td>
                        <td>@item.ItemName</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.Quantity</td>
                        <td>@item.Location</td>

                        <td class="text-center">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm">
                                <i class="fa fa-eye"></i>
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                <i class="fa fa-edit"></i>
                            </a>

                            <a asp-action="Consume"
                               asp-route-id="@item.Id"
                               class="btn btn-success btn-sm"
                               title="Consume">
                                <i class="fa-solid fa-box-open"></i>
                            </a>

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">No Non-ICT supplies found.</td>
                </tr>
            }

            </tbody>

        </table>

    </div>

</div>
}




    @if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}

</div>