@model InventorySystem.Models.ViewModels.InventoryFormViewModel

@{
    ViewData["Title"] = "Edit Item";
}

<div class="container-fluid py-4">

    <div class="card shadow border-0">

        <div class="card-header bg-warning">

            <h4 class="mb-0">
                Edit Inventory Item
            </h4>

        </div>


        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" hidden />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Item Code
                    </label>

                    <input asp-for="ItemCode"
                           class="form-control"
                           readonly />

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Item Name
                    </label>

                    <input asp-for="ItemName" id="ItemName"
                           class="form-control"/>

                    <span asp-validation-for="ItemName"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Category
                    </label>

                    <select asp-for="CategoryId"
                            asp-items="Model.Categories"
                            class="form-select"
                            id="CategoryId">
                            

                        <option value="">
                            Select Category
                        </option>

                    </select>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              id="Description">
                    </textarea>

                </div>

                <div id="serialGroup" class="mb-3">

                    <label asp-for="SerialNumber" class="form-label"></label>

                    <input asp-for="SerialNumber"
                        id="SerialNumber"
                        class="form-control" />

                    <span asp-validation-for="SerialNumber"
                        class="text-danger"></span>

                </div>

                <div id="quantityGroup" class="mb-3">

                    <label asp-for="Quantity" class="form-label"></label>

                    <input asp-for="Quantity"
                        id="Quantity"
                        class="form-control" />

                    <span asp-validation-for="Quantity"
                        class="text-danger"></span>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label">
                            Location
                        </label>

                        <input asp-for="Location"
                               class="form-control"
                               id="Location"/>

                    </div>

                </div>


                <div class="mt-4">

                    <button class="btn btn-warning">

                        Update

                    </button>


                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                </div>


            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const category = document.getElementById("CategoryId");

            const serialGroup = document.getElementById("serialGroup");
            const quantityGroup = document.getElementById("quantityGroup");

            const serial = document.getElementById("SerialNumber");
            const quantity = document.getElementById("Quantity");

            function toggleFields() {

                const selected = category.options[category.selectedIndex].text;

                if (selected === "ICT") {

                    serialGroup.style.display = "";
                    quantityGroup.style.display = "none";

                    serial.disabled = false;
                    quantity.disabled = true;

                }
                else {

                    serialGroup.style.display = "none";
                    quantityGroup.style.display = "";

                    serial.disabled = true;
                    quantity.disabled = false;

                }
            }

            category.addEventListener("change", toggleFields);

            toggleFields();

        });
    </script>
}