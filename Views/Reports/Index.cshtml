@{
    ViewData["Title"] = "Reports";
}


<div class="row g-4">

    <div class="col-md-3">
        <div class="card shadow p-4">
            <h6>Total Items</h6>
            <h2>@ViewBag.TotalItems</h2>
        </div>
    </div>


    <div class="col-md-3">
        <div class="card shadow p-4">
            <h6>ICT Assets</h6>
            <h2 class="text-primary">
                @ViewBag.ICTCount
            </h2>
        </div>
    </div>


    <div class="col-md-3">
        <div class="card shadow p-4">
            <h6>Non-ICT Assets</h6>
            <h2 class="text-success">
                @ViewBag.NonICTCount
            </h2>
        </div>
    </div>


<div class="col-md-3">
    <div class="card shadow p-4">
        <h6>Non-ICT Supplies</h6>
        <h2 class="text-success">
            @ViewBag.NonICTCount
        </h2>
    </div>
</div>


</div>


<hr/>


<div class="row g-4 mt-2">


    <div class="col-md-3">
        <div class="card shadow p-4">

            <h6>Available ICT</h6>

            <h2 class="text-success">
                @ViewBag.AvailableICT
            </h2>

        </div>
    </div>


    <div class="col-md-3">
        <div class="card shadow p-4">

            <h6>Borrowed ICT</h6>

            <h2 class="text-warning">
                @ViewBag.BorrowedICT
            </h2>

        </div>
    </div>




    <div class="col-md-3">
        <div class="card shadow p-4">

            <h6>Borrowers</h6>

            <h2>
                @ViewBag.TotalBorrowers
            </h2>

        </div>
    </div>


</div>


<hr/>


<a asp-action="Inventory"
   class="btn btn-primary">

    Inventory Report

</a>


<a asp-action="Transactions"
   class="btn btn-success">

    Transaction Report

</a>


<a asp-action="ArchivedTransactions"
   class="btn btn-secondary">

    Archived Transactions

</a>