@model List<InventorySystem.Models.Transaction>

<form method="get" class="row g-3 mb-4">

    <div class="col-md-3">
        <label>
            Start Date
        </label>

        <input type="date"
               name="startDate"
               value="@ViewBag.StartDate"
               class="form-control"/>
    </div>


    <div class="col-md-3">
        <label>
            End Date
        </label>

        <input type="date"
               name="endDate"
               value="@ViewBag.EndDate"
               class="form-control"/>
    </div>


    <div class="col-md-4">
        <label>
            Search
        </label>

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               placeholder="Item or borrower"
               class="form-control"/>
    </div>


    <div class="col-md-2 d-flex align-items-end">

        <button class="btn btn-primary w-100">
            Filter
        </button>

    </div>

</form>


<div class="mb-3">

    <a asp-action="ExportTransactions"
       class="btn btn-success">

        <i class="fa-solid fa-file-excel"></i>
        Export Excel

    </a>


    <button onclick="window.print()"
            class="btn btn-dark">

        <i class="fa-solid fa-print"></i>
        Print

    </button>

</div>


<div class="card shadow border-0">

    <div class="card-header">
        <h5 class="mb-0">
            Transaction History (@Model.Count)
        </h5>
    </div>


    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Date</th>
                        <th>Action</th>
                        <th>Item</th>
                        <th>Borrower</th>
                        <th>Quantity</th>
                        <th>Remarks</th>
                    </tr>

                </thead>


                <tbody>

                @foreach(var t in Model)
                {

                    <tr>

                        <td>
                            @t.TransactionDate.ToString("MMM dd, yyyy hh:mm tt")
                        </td>


                        <td>

                            @if(t.TransactionType == TransactionType.Borrow)
                            {
                                <span class="badge bg-warning">
                                    Borrow
                                </span>
                            }
                            else if(t.TransactionType == TransactionType.Return)
                            {
                                <span class="badge bg-success">
                                    Return
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-info">
                                    Receive
                                </span>
                            }

                        </td>


                        <td>
                            @t.Item?.ItemName
                        </td>


                        <td>
                            @t.Borrower?.FullName
                        </td>


                        <td>
                            @t.Quantity
                        </td>


                        <td>
                            @t.Remarks
                        </td>

                    </tr>

                }


                @if(!Model.Any())
                {
                    <tr>
                        <td colspan="6"
                            class="text-center p-4 text-muted">

                            No transactions found.

                        </td>
                    </tr>
                }


                </tbody>

            </table>

        </div>

    </div>

</div>